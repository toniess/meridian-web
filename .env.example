# Адрес бекенда вместе с префиксом /api.
# Если переменная пустая — сайт поднимется на встроенных демо-данных.
API_BASE=https://container-meridian.containerapps.ru/api

# Публичный адрес сайта: canonical-ссылки, OpenGraph, sitemap
NEXT_PUBLIC_SITE_URL=https://glushkov.ru

# Слаг проекта, который показывается в разделе «Меридиан».
# Если проекта с таким слагом нет, возьмётся первый из списка.
MERIDIAN_PROJECT_SLUG=meridian

# Кеш ответов API, секунды
REVALIDATE_SECONDS=60
# Кеш скачанных файлов книг, секунды
FILE_REVALIDATE_SECONDS=3600
